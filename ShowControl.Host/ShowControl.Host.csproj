<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net9.0;net9.0-windows10.0.22621.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net9.0;net9.0-maccatalyst</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
  </PropertyGroup>

  <!-- Define WINDOWS when targeting net8.0-windows -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net9.0-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Define MACCATALYST when targeting net8.0-maccatalyst -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <DefineConstants>$(DefineConstants);MACCATALYST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShowControl.Animation\ShowControl.Animation.csproj" />
    <ProjectReference Include="..\ShowControl.Devices.Audio\ShowControl.Devices.Audio.csproj" />
    <ProjectReference Include="..\ShowControl.Devices.DMX\ShowControl.Devices.DMX.csproj" />
    <ProjectReference Include="..\ShowControl.Devices.Input\ShowControl.Devices.Input.csproj" />
    <ProjectReference Include="..\ShowControl.Devices.Output\ShowControl.Devices.Output.csproj" />
    <ProjectReference Include="..\ShowControl.Rendering\ShowControl.Rendering.csproj" />
  </ItemGroup>
</Project>
