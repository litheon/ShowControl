<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net9.0;net9.0-windows10.0.22621.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net9.0;net9.0-maccatalyst</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Define MACCATALYST when targeting net8.0-maccatalyst -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <DefineConstants>$(DefineConstants);MACCATALYST</DefineConstants>
  </PropertyGroup>

  <!-- Define WINDOWS when targeting net8.0-windows -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net9.0-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <!-- .spv files are generated (not tracked in git); make sure Graphics has compiled and
       copied them here before bundle-resource collection validates the Content items above -->
  <Target Name="EnsureCompiledShaders" BeforeTargets="AssignTargetPaths;_CollectBundleResources" Condition="!Exists('kaleidoscope.frag.spv')">
    <MSBuild Projects="..\ShowControl.Graphics\ShowControl.Graphics.csproj" Targets="CompileShaders" Properties="TargetFramework=net9.0" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShowControl.Animation\ShowControl.Animation.csproj" />
    <ProjectReference Include="..\ShowControl.AudioAnalysis\ShowControl.AudioAnalysis.csproj" />
    <ProjectReference Include="..\ShowControl.Devices.Audio\ShowControl.Devices.Audio.csproj" />
    <ProjectReference Include="..\ShowControl.Devices.DMX\ShowControl.Devices.DMX.csproj" />
    <ProjectReference Include="..\ShowControl.Devices.Input\ShowControl.Devices.Input.csproj" />
    <ProjectReference Include="..\ShowControl.Devices.Output\ShowControl.Devices.Output.csproj" />
    <ProjectReference Include="..\ShowControl.Rendering\ShowControl.Rendering.csproj" />
  </ItemGroup>
</Project>
