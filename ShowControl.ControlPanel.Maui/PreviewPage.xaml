<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:graphics="clr-namespace:ShowControl.Graphics;assembly=ShowControl.Graphics"
             x:Class="ShowControl.ControlPanel.Maui.PreviewPage"
             Title="Graphics Preview"
             >

    <Grid BackgroundColor="Transparent">
        <graphics:VulkanSurfaceView x:Name="vulkanSurface" />
        <Polyline
        Stroke="Red"
        StrokeThickness="2"
        Points="0,50 50,0 100,50">
        </Polyline>
        <Label x:Name="ShaderParamsLabel"
               TextColor="Red"
               FontFamily="Courier New"
               FontSize="12"
               VerticalOptions="Start"
               HorizontalOptions="Start"
               Margin="8"
               Text="Shader Params" />
    </Grid>
    
</ContentPage>
