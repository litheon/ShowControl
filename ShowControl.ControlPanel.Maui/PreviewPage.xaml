<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:graphics="clr-namespace:ShowControl.Graphics;assembly=ShowControl.Graphics"
             xmlns:editor="clr-namespace:ShowControl.ControlPanel.Editor;assembly=ShowControl.ControlPanel.Editor"
             xmlns:mapping="clr-namespace:ShowControl.PixelMapping;assembly=ShowControl.PixelMapping"
             x:Class="ShowControl.ControlPanel.Maui.PreviewPage"
             x:DataType="editor:PixelMapEditorViewModel"
             Title="Graphics Preview"
             >

    <ContentPage.Resources>
        <!-- Caption above an editor field. Dimmer and smaller than the value it names, so a column
             of them reads as labels rather than as more content. -->
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#FFBBBBBB" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- One row of a value list. A clickable Label rather than a Button so the text is
             left-aligned under its caption like every other field's value, and the rows read as a
             list instead of a stack of controls. -->
        <Style x:Key="OptionRow" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <!-- The box a value list sits in, so it reads as one field rather than loose rows. -->
        <Style x:Key="OptionList" TargetType="Border">
            <Setter Property="Stroke" Value="#30FFFFFF" />
            <Setter Property="BackgroundColor" Value="#20FFFFFF" />
            <Setter Property="Padding" Value="0,2" />
        </Style>

        <!-- A text box on the panel. The colours are explicit, not themed: the app-wide Entry style
             follows the system theme (black text in light mode), but this panel is dark whatever
             the theme, and black on near-black was unreadable the moment macOS was in light mode.
             The background is a shade lighter than the panel so the box itself is visible. -->
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="PlaceholderColor" Value="#80FFFFFF" />
            <Setter Property="BackgroundColor" Value="#FF2A2A2A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinimumHeightRequest" Value="28" />
        </Style>

        <!-- A multi-line readout: monospaced so the columns of numbers line up. -->
        <Style x:Key="Readout" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="Courier New" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>

    <!-- Single-cell grid: every child fills it and stacks in declaration order. The surface has no
         size request, so the overlay's bounds are identical to it and no offset term is needed.

         x:DataType is set on the page and on every template: it makes the bindings compiled, so a
         path that does not exist on the view-model is a build error rather than a control that
         silently shows nothing. That check is the point of moving this much state into bindings. -->
    <Grid BackgroundColor="Transparent">
        <!-- The zoom is a compositing transform on the surface — scale about an anchor — and never
             a change to the render path: the view's bounds do not move, so no swapchain is rebuilt
             and the LEDs are unaffected. Bound rather than assigned so there is one place the zoom
             state lives; the overlay is redrawn from the equivalent PreviewRegion in code-behind,
             which is what keeps it vector-crisp instead of magnified. -->
        <graphics:VulkanSurfaceView x:Name="vulkanSurface"
                                    Scale="{Binding Zoom.Zoom}"
                                    AnchorX="{Binding Zoom.AnchorX}"
                                    AnchorY="{Binding Zoom.AnchorY}" />

        <!-- Pixel map overlay. Hidden and input-transparent unless edit mode is on, so the preview
             stays clean during a show. The near-transparent background is deliberate: a fully
             transparent element is not reliably hit-testable over a SwapChainPanel on Windows. -->
        <GraphicsView x:Name="MapOverlay"
                      IsVisible="{Binding IsEditing}"
                      InputTransparent="{Binding IsNotEditing}"
                      BackgroundColor="#01000000">
            <GraphicsView.GestureRecognizers>
                <!-- PointerExited ends the drag too: on Mac Catalyst a drag that leaves the view
                     is reported as an exit and the gesture then ends without a PointerReleased. -->
                <PointerGestureRecognizer PointerPressed="OnOverlayPointerPressed"
                                          PointerMoved="OnOverlayPointerMoved"
                                          PointerReleased="OnOverlayPointerReleased"
                                          PointerExited="OnOverlayPointerExited" />
                <PinchGestureRecognizer PinchUpdated="OnOverlayPinch" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <!-- Editor panel -->
        <Border x:Name="EditorPanel"
                IsVisible="{Binding IsEditing}"
                HorizontalOptions="End"
                VerticalOptions="Fill"
                WidthRequest="340"
                BackgroundColor="#DD101010"
                Stroke="#40FFFFFF"
                Padding="10">
            <ScrollView>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Pixel Map" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding DirtyText}" TextColor="Orange" FontSize="11" />

                    <!-- Commands, not Clicked handlers: the dialog these raise is the platform's,
                         but deciding whether to ask, what to suggest as a filename and what to do
                         with the answer is editor logic and lives in the view-model. -->
                    <HorizontalStackLayout Spacing="6">
                        <Button Text="Open" FontSize="11" Padding="8,2" Command="{Binding OpenCommand}" />
                        <Button Text="Save" FontSize="11" Padding="8,2" Command="{Binding SaveCommand}" />
                        <Button Text="Save As…" FontSize="11" Padding="8,2" Command="{Binding SaveAsCommand}" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#40FFFFFF" />

                    <Label Text="Fixtures" TextColor="White" FontSize="13" FontAttributes="Bold" />
                    <!-- MeasureFirstItem plus a fixed row height on purpose: the rows are uniform,
                         and self-sizing cells make UICollectionViewFlowLayout invalidate its layout
                         while animating an insert, which it answers by throwing. On Mac Catalyst
                         that NSException comes back through the managed handler and aborts.
                         SelectedItem is deliberately NOT bound: the code-behind assigns it only when
                         it actually differs, which is what keeps redundant index-path selections
                         away from a list that has just changed shape. -->
                    <CollectionView x:Name="FixtureList" HeightRequest="220" SelectionMode="Single"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    ItemsSource="{Binding Rows}"
                                    SelectionChanged="OnFixtureSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="editor:FixtureRow">
                                <Grid ColumnDefinitions="Auto,*" Padding="0,2" HeightRequest="28">
                                    <!-- OneWay: FixtureRow is an immutable record, and the enabled
                                         flag is changed through the button below so the edit goes
                                         through validation and publishing like any other. -->
                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Color="White" />
                                    <Label Grid.Column="1" Text="{Binding Description}" TextColor="White"
                                           FontSize="11" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- How the preview is driven. Written down because none of it is discoverable:
                         the second press on a fixture does something different from the first. -->
                    <Label Style="{StaticResource FieldLabel}" LineBreakMode="WordWrap"
                           Text="Drag a fixture to move it. Drag a pixel of the selected fixture to bend the run there (the rest follows the cursor, snapping to 45°); drag its ringed first pixel to rotate it. Drag empty space to pan, scroll to zoom." />

                    <!-- Every field of the selected fixture. The list row is one truncating line,
                         and the channel range in particular has to be readable in full to wire the
                         next strip after it. -->
                    <Label Text="Selected fixture" TextColor="White" FontSize="13" FontAttributes="Bold" />
                    <Border Style="{StaticResource OptionList}" Padding="6,4">
                        <Label Style="{StaticResource Readout}" Text="{Binding SelectedFixtureDetail}" />
                    </Border>

                    <HorizontalStackLayout Spacing="6">
                        <Button Text="Remove" FontSize="11" Padding="8,2" Command="{Binding RemoveFixtureCommand}" />
                        <Button Text="Toggle enabled" FontSize="11" Padding="8,2" Command="{Binding ToggleEnabledCommand}" />
                    </HorizontalStackLayout>

                    <!-- Flip: for a strip whose data-in end is the opposite one to what the map
                         assumes — the run stays where it is, the pixel order reverses, and the
                         overlay's ring marks the first pixel so the result is visible at a glance.
                         Straighten: the way back from any bend, deliberate or not. -->
                    <HorizontalStackLayout Spacing="6">
                        <Button Text="Flip direction" FontSize="11" Padding="8,2" Command="{Binding FlipDirectionCommand}" />
                        <Button Text="Straighten" FontSize="11" Padding="8,2" Command="{Binding StraightenCommand}" />
                    </HorizontalStackLayout>

                    <!-- Spacing of the selected fixture, read back off its stored offsets. Applying
                         scales the run about its first pixel, so the fixture keeps its position and
                         its shape and only the gap between pixels changes. -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Pixel spacing" TextColor="White" FontSize="11" VerticalOptions="Center" WidthRequest="90" />
                        <Entry Text="{Binding SpacingText}" Placeholder="Spacing" WidthRequest="70"
                               Style="{StaticResource FieldEntry}" Keyboard="Numeric" ReturnCommand="{Binding ApplySpacingCommand}" />
                        <Button Text="Apply" FontSize="11" Padding="8,2" Command="{Binding ApplySpacingCommand}" />
                    </HorizontalStackLayout>

                    <!-- Total turn of the selected run, measured the same way. Applying lays it out
                         as an even arc with that much turn: 0 is straight, 90 a quarter turn, 360 a
                         ring. For a corner at one pixel, bend by dragging instead. -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Bend (degrees)" TextColor="White" FontSize="11" VerticalOptions="Center" WidthRequest="90" />
                        <Entry Text="{Binding BendText}" Placeholder="0" WidthRequest="70"
                               Style="{StaticResource FieldEntry}" Keyboard="Numeric" ReturnCommand="{Binding ApplyBendCommand}" />
                        <Button Text="Apply" FontSize="11" Padding="8,2" Command="{Binding ApplyBendCommand}" />
                    </HorizontalStackLayout>

                    <!-- Pixels that sample as black — a dead tail, a cut-out segment. Wire
                         positions, zero-based and inclusive, so they keep their channels and the
                         strips after them stay addressed where they are. -->
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Blanked pixels (0-based, e.g. 12-15, 40)" Style="{StaticResource FieldLabel}" />
                        <HorizontalStackLayout Spacing="6">
                            <Entry Text="{Binding BlankedText}" Placeholder="none" WidthRequest="200"
                                   Style="{StaticResource FieldEntry}" ReturnCommand="{Binding ApplyBlankedCommand}" />
                            <Button Text="Apply" FontSize="11" Padding="8,2" Command="{Binding ApplyBlankedCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#40FFFFFF" />

                    <!-- Wiring checks. These replace the animation on the rig (and colour the dots
                         above to match) and are session state, not part of the map: leaving edit
                         mode switches them all off, so a show cannot be left with one strip lit. -->
                    <Label Text="Wiring check" TextColor="White" FontSize="13" FontAttributes="Bold" />
                    <Label Text="{Binding OutputOverrideText}" Style="{StaticResource FieldLabel}" LineBreakMode="WordWrap" />
                    <HorizontalStackLayout Spacing="6">
                        <Button Text="Chase" FontSize="11" Padding="8,2" Command="{Binding SetTestPatternCommand}"
                                CommandParameter="{x:Static mapping:PixelTestPattern.Chase}" />
                        <Button Text="Rainbow" FontSize="11" Padding="8,2" Command="{Binding SetTestPatternCommand}"
                                CommandParameter="{x:Static mapping:PixelTestPattern.Rainbow}" />
                        <Button Text="Colours" FontSize="11" Padding="8,2" Command="{Binding SetTestPatternCommand}"
                                CommandParameter="{x:Static mapping:PixelTestPattern.FixtureColors}" />
                        <Button Text="White" FontSize="11" Padding="8,2" Command="{Binding SetTestPatternCommand}"
                                CommandParameter="{x:Static mapping:PixelTestPattern.White}" />
                        <Button Text="Diagonals" FontSize="11" Padding="8,2" Command="{Binding SetTestPatternCommand}"
                                CommandParameter="{x:Static mapping:PixelTestPattern.Diagonals}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <Button Text="Pattern off" FontSize="11" Padding="8,2" Command="{Binding SetTestPatternCommand}"
                                CommandParameter="{x:Static mapping:PixelTestPattern.None}" />
                        <Button Text="Solo selected" FontSize="11" Padding="8,2" Command="{Binding SoloSelectedCommand}" />
                        <Button Text="Show animation" FontSize="11" Padding="8,2" Command="{Binding ClearOutputOverrideCommand}" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#40FFFFFF" />

                    <Label Text="Add or edit fixture" TextColor="White" FontSize="13" FontAttributes="Bold" />
                    <!-- One form for both: Add builds a new fixture from it, Load selected fills it
                         from the selection, Apply to selected writes it back. -->
                    <HorizontalStackLayout Spacing="6">
                        <Button Text="Load selected" FontSize="11" Padding="8,2" Command="{Binding LoadSelectedIntoFormCommand}" />
                        <Button Text="Apply to selected" FontSize="11" Padding="8,2" Command="{Binding ApplyFormToSelectedCommand}" />
                    </HorizontalStackLayout>

                    <!-- Each field is a caption over its editor, paired in its own tight stack so
                         the 6pt spacing of the panel separates fields rather than splitting a label
                         from what it names. The captions replace the placeholders: a placeholder
                         disappears the moment a value is typed, which is exactly when a column of
                         numbers stops being self-explanatory. -->
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Name" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding NewName}" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>

                    <!-- Not a Picker: MAUI renders one as a UIPickerView on Mac Catalyst, which is
                         a phone thumb-wheel in a popover. Two choices fit as a list, so the panel
                         draws the list. Each row carries its own command, so nothing here has to
                         reach back up to the page's binding context. -->
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Interface" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource OptionList}">
                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding InterfaceOptionRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="editor:OptionRow">
                                        <Label Text="{Binding Display}" Style="{StaticResource OptionRow}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ChooseCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="IP address" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding NewIpAddress}" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="Port (DDP)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding NewPort}" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="Universe (ArtNet)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding NewUniverse}" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>

                    <!-- Pre-filled with the first free channel on the controller the form describes
                         — the sum of pixel counts times channels per pixel of every strip already
                         there — and it follows the controller fields until something else is typed.
                         The hint says which strip it comes after, so it can be checked against the
                         list. Zero-based, as the file stores it and the list shows it. -->
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Start channel (0-based; filled in for you)" Style="{StaticResource FieldLabel}" />
                        <HorizontalStackLayout Spacing="6">
                            <Entry Text="{Binding NewStartChannel}" Keyboard="Numeric" WidthRequest="90"
                                   Style="{StaticResource FieldEntry}" />
                            <Button Text="Use next free" FontSize="11" Padding="8,2" Command="{Binding UseNextFreeChannelCommand}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding StartChannelHint}" Style="{StaticResource FieldLabel}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- The whole catalogue, listed. Nine short rows are cheaper to read than any
                         popup, and the panel already scrolls — a nested scroller here would fight
                         the outer one for the gesture. -->
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Pixel type" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource OptionList}">
                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding PixelTypeOptionRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="editor:OptionRow">
                                        <Label Text="{Binding Display}" Style="{StaticResource OptionRow}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ChooseCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="Pixel count" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding NewPixelCount}" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>

                    <!-- Spacing and angle lay the run out at creation; neither is stored in the map.
                         1.25 is the shipped rig's spacing: one LED per image pixel at the render
                         target's previous size, scaled with it. On Apply to selected they lay out
                         only the pixels a larger count adds; the boxes above change an existing run. -->
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Spacing (image px; new pixels only)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding NewSpacing}" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="Angle (degrees; new pixels only)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding NewAngle}" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>

                    <Button Text="Add" FontSize="11" Padding="8,2" Command="{Binding AddFixtureCommand}" />

                    <Label Text="{Binding StatusText}" TextColor="#FFAAAAAA" FontSize="10" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Edit mode switch, zoom controls and shader parameters.
             The zoom controls sit here rather than in EditorPanel so they stay put when the panel
             is scrolled, and are hidden with edit mode because that is when the zoom resets.

             The switch is bound rather than handled: everything switching it on and off has to do —
             adopting the live map, stashing and restoring the zoom, dropping a gesture in flight,
             flushing the working copy — hangs off IsEditing in the view-model, so it happens
             whatever moved it. -->
        <HorizontalStackLayout VerticalOptions="Start" HorizontalOptions="Start" Margin="8,8,0,0" Spacing="6">
            <Switch x:Name="EditModeSwitch" IsToggled="{Binding IsEditing}" />
            <Label Text="Edit pixel map" TextColor="Red" FontSize="12" VerticalOptions="Center" />

            <HorizontalStackLayout x:Name="ZoomControls" IsVisible="{Binding IsEditing}" Spacing="4" Margin="12,0,0,0">
                <Button Text="−" FontSize="12" Padding="10,2" Command="{Binding Zoom.ZoomOutCommand}" />
                <Button Text="+" FontSize="12" Padding="10,2" Command="{Binding Zoom.ZoomInCommand}" />
                <Button Text="Fit" FontSize="11" Padding="8,2" Command="{Binding Zoom.FitCommand}" />
                <Label Text="{Binding Zoom.Label}" TextColor="Red" FontSize="12"
                       WidthRequest="46" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <!-- The knob readout. The page polls the graphics host and hands the numbers to the
             view-model, which decides what each knob is called for the running shader. -->
        <Label x:Name="ShaderParamsLabel"
               TextColor="Red"
               FontFamily="Courier New"
               FontSize="12"
               VerticalOptions="Start"
               HorizontalOptions="Start"
               Margin="8,40,0,0"
               Text="{Binding ShaderParameters.Text}" />
    </Grid>

</ContentPage>
