<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ShowControl.ControlPanel.Maui"
             xmlns:editor="clr-namespace:ShowControl.ControlPanel.Editor;assembly=ShowControl.ControlPanel.Editor"
             x:Class="ShowControl.ControlPanel.Maui.MainPage"
             x:DataType="local:MainPageViewModel">

    <!-- The readouts are bound, not assigned: they are written from the audio callback and the
         render thread, and a binding means those paths marshal to the UI thread and set a property
         rather than reaching into a named control. The audio debug drawable below is the exception
         — it is a per-tick redraw against the control's own size, with no bindable equivalent —
         and stays in the code-behind (the old FFT polyline's precedent). -->
    <Grid RowDefinitions="*,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollView Grid.Row="0" Grid.Column="0">
            <VerticalStackLayout>
                <Label Width="200" Text="{Binding BpmText}"></Label>
                <Label Width="200" Text="{Binding AmplitudeRatioText}"></Label>
                <Label Width="200" Text="{Binding BassAmplitudeCurrentText}"></Label>
                <Label Width="200" Text="{Binding BassAmplitudeAverageText}"></Label>

                <!-- Capture-device picker: rows the panel draws, not a Picker (the
                     thumb-wheel/broken-selection rule) — the ● marks what is actually
                     capturing, re-checked after every switch. -->
                <Label Text="Input device" FontAttributes="Bold" Margin="0,12,0,2" />
                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding AudioDevices.DeviceRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="editor:OptionRow">
                            <Label Text="{Binding Display}" Padding="4,3">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding AudioDevices.StatusText}" FontSize="11" TextColor="Orange" />

                <Label Width="400" Text="{Binding DeviceSummaryText}" Margin="0,12,0,0"></Label>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Audio debug view: every published analysis field, rendered ugly and complete.
             The buttons run synthetic presets through the same engine live capture feeds. -->
        <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <HorizontalStackLayout Grid.Row="0" Spacing="6" Padding="6,4">
                <Button Text="Clicks" Command="{Binding Audio.StartPresetCommand}" CommandParameter="ClickTrack"
                        Padding="10,0" HeightRequest="30" />
                <Button Text="Kicks" Command="{Binding Audio.StartPresetCommand}" CommandParameter="NoiseFloorWithKicks"
                        Padding="10,0" HeightRequest="30" />
                <Button Text="Sweep" Command="{Binding Audio.StartPresetCommand}" CommandParameter="Sweep"
                        Padding="10,0" HeightRequest="30" />
                <Button Text="Burst" Command="{Binding Audio.StartPresetCommand}" CommandParameter="SingleBurst"
                        Padding="10,0" HeightRequest="30" />
                <Button Text="Silence" Command="{Binding Audio.StartPresetCommand}" CommandParameter="Silence"
                        Padding="10,0" HeightRequest="30" />
                <Button Text="Stop" Command="{Binding Audio.StopSyntheticCommand}"
                        Padding="10,0" HeightRequest="30" />
                <Button Text="Grid" Command="{Binding Audio.ToggleSyntheticGridCommand}"
                        Padding="10,0" HeightRequest="30" />
                <Label Text="{Binding Audio.SourceText}" VerticalOptions="Center" FontSize="12" />
            </HorizontalStackLayout>
            <GraphicsView x:Name="AudioDebugView" Grid.Row="1" MinimumHeightRequest="200" />
            <HorizontalStackLayout Grid.Row="2" Spacing="24" Padding="6,4">
                <Label Text="{Binding Audio.LiteText}" FontFamily="Courier New" FontSize="11" />
                <Label Text="{Binding Audio.TimingText}" FontFamily="Courier New" FontSize="11" />
                <Label Text="{Binding Audio.FeatureText}" FontFamily="Courier New" FontSize="11" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Log pane: tails the in-memory Serilog sink -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="240" Margin="0,4,0,0">
            <Grid RowDefinitions="Auto,*">
                <HorizontalStackLayout Grid.Row="0" Spacing="12" Padding="6,4">
                    <Label Text="Log" FontAttributes="Bold" VerticalOptions="Center" />
                    <CheckBox IsChecked="{Binding AutoScrollLog}" VerticalOptions="Center" />
                    <Label Text="Auto-scroll" VerticalOptions="Center" />
                    <Button Text="Clear" Command="{Binding ClearLogCommand}"
                            Padding="10,0" HeightRequest="30" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <!-- A plain text tail, not a CollectionView: virtualized-list row churn (inserts,
                     trims, scroll-to-end) is O(row count) native work on Catalyst and stalled the
                     main thread whenever the pane was full and logs flowed. One Label text
                     assignment per pump is a single native text layout, no per-row cost. The
                     colored history lives in the log file. -->
                <ScrollView x:Name="LogScroll" Grid.Row="1" Margin="6,0,6,6">
                    <!-- No LineBreakMode here: on Catalyst, NoWrap (and the truncation modes)
                         map to a single-line native label, which rendered exactly one line of
                         the whole tail. Default word wrap shows everything; long lines wrap. -->
                    <Label x:Name="LogLabel" Text="{Binding LogText}" FontSize="11"
                           FontFamily="Menlo" />
                </ScrollView>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
