<!-- Directory.Build.targets -->
<Project>
  <!-- Windows 64-bit build flavor (skip when targeting maccatalyst on Windows) -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(Platform)' == 'x64' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst'">
    <DefineConstants>$(DefineConstants);WINDOWS;WIN64</DefineConstants>
  </PropertyGroup>

  <!-- Windows 32-bit build flavor -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(Platform)' == 'x86' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst'">
    <DefineConstants>$(DefineConstants);WINDOWS;WIN32</DefineConstants>
  </PropertyGroup>

  <!-- Windows AnyCPU - default to 64-bit -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(Platform)' != 'x64' And '$(Platform)' != 'x86' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst'">
    <DefineConstants>$(DefineConstants);WINDOWS;WIN64</DefineConstants>
  </PropertyGroup>

  <!-- MacCatalyst build flavor (either on Mac, or cross-compiling maccatalyst TFM on Windows) -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <DefineConstants>$(DefineConstants);MAC;ARM64</DefineConstants>
  </PropertyGroup>

  <!-- Native library paths -->
  <PropertyGroup>
    <NativeLibOutputDir>$(MSBuildThisFileDirectory)native\lib\</NativeLibOutputDir>
    <PortAudioSourceDir>$(MSBuildThisFileDirectory)external\portaudio\</PortAudioSourceDir>
    <RtMidiSourceDir>$(MSBuildThisFileDirectory)external\rtmidi\</RtMidiSourceDir>
  </PropertyGroup>

  <!-- MacCatalyst native library outputs -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <PortAudioLib>$(NativeLibOutputDir)mac\libportaudio.dylib</PortAudioLib>
    <RtMidiLib>$(NativeLibOutputDir)mac\librtmidi.dylib</RtMidiLib>
  </PropertyGroup>

  <!-- Windows native library outputs -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <PortAudioLib>$(NativeLibOutputDir)win\portaudio.dll</PortAudioLib>
    <RtMidiLib>$(NativeLibOutputDir)win\rtmidi.dll</RtMidiLib>
  </PropertyGroup>
</Project>
