<!-- Directory.Build.targets -->
<Project>
  <!-- Windows build flavor -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- MacCatalyst build flavor -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <DefineConstants>$(DefineConstants);MAC;ARM64</DefineConstants>
  </PropertyGroup>
</Project>
