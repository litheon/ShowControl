<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target: net8.0 for Windows, net8.0 and net8.0-maccatalyst for Mac -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net9.0;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net9.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
    <!-- Define WINDOWS constant for conditional compilation -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('windows'))">$(DefineConstants);WINDOWS</DefineConstants>
    <!-- Define MACCATALYST constant when targeting maccatalyst -->
    <DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(DefineConstants);MACCATALYST</DefineConstants>
    <!-- Fallback for when building outside the MAUI app context -->
    <MauiVersion Condition="'$(MauiVersion)' == ''">9.0.0</MauiVersion>
    <!-- Windows: full path to glslc.exe inside the Vulkan SDK -->
    <VulkanSDK Condition="'$(VulkanSDK)' == '' AND $([MSBuild]::IsOSPlatform('windows'))">C:\VulkanSDK\1.4.321.1</VulkanSDK>
    <GlslcPath Condition="$([MSBuild]::IsOSPlatform('windows'))">$(VulkanSDK)\Bin\glslc.exe</GlslcPath>
    <!-- Mac/Linux: glslc expected on PATH (from LunarG Vulkan SDK or Homebrew) -->
    <GlslcPath Condition="!$([MSBuild]::IsOSPlatform('windows'))">glslc</GlslcPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Core" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!-- Windows-only DirectX packages for Vulkan/D3D11 interop -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.22.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.22.0" />
    <PackageReference Include="Silk.NET.DirectComposition" Version="2.22.0" />
  </ItemGroup>

  <!-- Shader files -->
  <ItemGroup>
    <ShaderSource Include="**\*.vert" />
    <ShaderSource Include="**\*.frag" />
    <!-- Exclude compiled shaders from project - they're copied to MAUI Resources -->
    <None Remove="**\*.spv" />
  </ItemGroup>

  <!-- Compile shaders before build -->
  <Target Name="CompileShaders" BeforeTargets="BeforeBuild">
    <Message Text="Compiling Vulkan shaders..." Importance="high" />
    <!-- Windows: check that glslc.exe exists at the known SDK path before invoking -->
    <Exec Command="&quot;$(GlslcPath)&quot; &quot;%(ShaderSource.FullPath)&quot; -o &quot;%(ShaderSource.FullPath).spv&quot;"
          Condition="$([MSBuild]::IsOSPlatform('windows')) AND Exists('$(GlslcPath)')"
          WorkingDirectory="$(ProjectDir)" />
    <Error Text="Vulkan SDK glslc.exe not found at $(GlslcPath). Install the Vulkan SDK or set $(VulkanSDK)."
           Condition="$([MSBuild]::IsOSPlatform('windows')) AND !Exists('$(GlslcPath)')" />
    <!-- Mac/Linux: invoke glslc from PATH; will error at build time if not installed -->
    <Exec Command="glslc &quot;%(ShaderSource.FullPath)&quot; -o &quot;%(ShaderSource.FullPath).spv&quot;"
          Condition="!$([MSBuild]::IsOSPlatform('windows'))"
          WorkingDirectory="$(ProjectDir)" />
  </Target>

  <!-- Copy compiled shaders to MAUI Resources -->
  <Target Name="CopyCompiledShadersToMaui" AfterTargets="CompileShaders" Condition="Exists('..\ShowControl.ControlPanel.Maui\Resources\Raw')">
    <ItemGroup>
      <CompiledShaders Include="**\*.spv" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledShaders)"
          DestinationFolder="..\ShowControl.ControlPanel.Maui\Resources\Raw"
          SkipUnchangedFiles="true" />
    <Message Text="Copied %(CompiledShaders.Filename)%(CompiledShaders.Extension) to MAUI Resources\Raw"
             Importance="high" />
  </Target>

  <!-- Copy compiled shaders to Host, which bundles them as Content in its output -->
  <Target Name="CopyCompiledShadersToHost" AfterTargets="CompileShaders" Condition="Exists('..\ShowControl.Host')">
    <ItemGroup>
      <CompiledShadersForHost Include="**\*.spv" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledShadersForHost)"
          DestinationFolder="..\ShowControl.Host"
          SkipUnchangedFiles="true" />
    <Message Text="Copied %(CompiledShadersForHost.Filename)%(CompiledShadersForHost.Extension) to ShowControl.Host"
             Importance="high" />
  </Target>
</Project>
