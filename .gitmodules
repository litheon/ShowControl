[submodule "external/portaudio"]
	path = external/portaudio
	url = https://github.com/PortAudio/portaudio
[submodule "external/PortAudioSharp2"]
	path = external/PortAudioSharp2
	url = https://github.com/litheon/PortAudioSharp2.git
[submodule "external/rtmidi"]
	path = external/rtmidi
	url = https://github.com/litheon/rtmidi.git
[submodule "external/RtMidi.Core"]
	path = external/RtMidi.Core
	url = https://github.com/litheon/RtMidi.Core.git
	ignore = dirty
[submodule "external/soundtouch.net"]
	path = external/soundtouch.net
	url = https://github.com/litheon/soundtouch.net.git
[submodule "external/ArtNetSharp"]
	path = external/ArtNetSharp
	url = https://github.com/litheon/ArtNetSharp.git
[submodule "external/BeatLinkNet"]
	path = external/BeatLinkNet
	url = https://github.com/litheon/BeatLinkNet.git
