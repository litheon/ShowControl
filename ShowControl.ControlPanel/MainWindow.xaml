<Window x:Class="ShowControl.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShowControl.ControlPanel"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="2000">
    <Grid>
        <Canvas x:Name="FftCanvas" HorizontalAlignment="Right">
            <Polyline x:Name="polyline" Stroke="DarkGreen" StrokeThickness="3" Height="1000" Width="2000"/>
        </Canvas>
        <ScrollViewer HorizontalAlignment="Left">
            <TextBlock x:Name="FrequencyOutput" Height="3600" Width="300" ></TextBlock>
        </ScrollViewer>
    </Grid>
</Window>
