<Window x:Class="ShowControl.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShowControl.ControlPanel"
        mc:Ignorable="d"
        Title="MainWindow" Height="1400" Width="2400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Canvas x:Name="FftCanvas" HorizontalAlignment="Right" Margin="0">
            <Border BorderThickness="2" BorderBrush="Red">
                <Polyline x:Name="polyline" Stroke="DarkBlue" StrokeThickness="3" Height="600" Width="1000" />
            </Border>

        </Canvas>
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="Bpm" Width="200" Text="BPM"></TextBlock>
            <TextBlock x:Name="Addresses" Width="400" Text="Devices"></TextBlock>
        </StackPanel>
    </Grid>
</Window>
