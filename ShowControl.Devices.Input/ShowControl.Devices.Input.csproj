<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net8.0-windows10.0.22621.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Define WINDOWS_TFM when targeting net8.0-windows -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net8.0-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS_TFM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\external\RtMidi.Core\RtMidi.Core\RtMidi.Core.csproj" />
  </ItemGroup>
</Project>
