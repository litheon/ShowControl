<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net9.0;net9.0-windows10.0.22621.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net9.0;net9.0-maccatalyst</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
  </PropertyGroup>

  <!-- Define WINDOWS_TFM when targeting net8.0-windows -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net9.0-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS_TFM</DefineConstants>
  </PropertyGroup>

  <!-- Define MACCATALYST when targeting net8.0-maccatalyst -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <DefineConstants>$(DefineConstants);MACCATALYST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\external\RtMidi.Core\RtMidi.Core\RtMidi.Core.csproj" />
  </ItemGroup>
</Project>
